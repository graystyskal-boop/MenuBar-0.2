<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MenuBarAssistant</string>
    <key>CFBundleIdentifier</key>
    <string>com.yourname.menubarassistant</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Standard, documented flag for menu-bar-only apps (Bartender, Rectangle,
         etc. all use it). Hides Dock icon and Cmd-Tab entry. Does NOT hide the
         process from Activity Monitor, `ps`, or affect Force Quit / kill. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Personal use</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Used to register your custom global keyboard shortcut.</string>
</dict>
</plist>
